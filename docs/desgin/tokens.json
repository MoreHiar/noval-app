{
  "$description": "Noval 页面设计 V1，逻辑单位为 dp / sp；仅供设计交接，不由应用导入。",
  "colors": {
    "background": "#F6F3EC",
    "surface": "#FFFEFA",
    "textPrimary": "#252D28",
    "textSecondary": "#677169",
    "primary": "#294E42",
    "primarySoft": "#E8EEE5",
    "accent": "#BA694B",
    "border": "#E3E5DC",
    "danger": "#A34436",
    "readerBackground": "#F4EFDF",
    "readerText": "#403E35",
    "readerSecondary": "#706755"
  },
  "typography": {
    "uiFont": "platform system sans-serif",
    "editorialFont": "platform serif with system fallback",
    "codeFont": "platform monospace",
    "pageTitle": { "size": 27, "weight": "600", "lineHeight": 36 },
    "sectionTitle": { "size": 17, "weight": "600", "lineHeight": 25 },
    "body": { "size": 14, "weight": "400", "lineHeight": 24 },
    "secondary": { "size": 12, "weight": "400", "lineHeight": 21 },
    "button": { "size": 14, "weight": "600", "lineHeight": 21 },
    "reader": { "size": 18, "lineSpacing": 1.9, "minSize": 14, "maxSize": 30 },
    "tabLabel": { "size": 10, "weight": "600", "lineHeight": 14 }
  },
  "spacing": [4, 8, 12, 16, 20, 24, 32, 40],
  "layout": { "referenceWidth": 390, "referenceHeight": 844, "pageGutter": 24, "minimumViewportWidth": 320, "tabletMaxContentWidth": 760, "readerMaxTextWidth": 640, "minimumTouchTarget": 44, "primaryButtonHeight": 50, "inputHeight": 50, "chapterRowMinHeight": 60 },
  "radii": { "small": 8, "input": 12, "button": 13, "card": 18, "sheet": 24, "tabbar": 25 },
  "motion": { "pressDurationMs": 120, "panelDurationMs": 220, "selectionDurationMs": 180, "respectReducedMotion": true, "readerAnimations": ["slide", "fade", "none"] },
  "readerOptions": { "fontStep": 2, "lineSpacing": [1.5, 1.9, 2.3], "animation": ["slide", "fade", "none"] }
}
